{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatwright-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "chatwright.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/chatwright-studio-prototype/browser",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
