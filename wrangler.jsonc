{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no `main`, so no request runs Worker code (static
  // asset requests are free and unmetered). `pnpm build:cloudflare` builds
  // dist/site/ — prerendered pages, the Studio app under /studio/, and the
  // `_redirects`/`_headers` rules (see scripts/build-site.mjs, site/pages.ts).
  "name": "chatwright-dev",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "chatwright.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/site",
    // 404.html (site) and studio/404.html (the Studio shell) answer misses.
    "not_found_handling": "404-page"
  }
}
